# ─── Supabase ────────────────────────────────────────────────────────────────
# https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose

# ─── Stripe ──────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...                    # from stripe listen --forward-to

# Stripe Price IDs — create in Stripe Dashboard → Products
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_MONTHLY=price_...

# ─── Resend (transactional email) ─────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=studio@yourdomain.com

# ─── Anthropic (AI features) ─────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── PostHog (analytics) ─────────────────────────────────────────────────────
# https://app.posthog.com → Project Settings
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://app.posthog.com

# ─── Sentry (error monitoring) ───────────────────────────────────────────────
# https://sentry.io → Project → Settings → Client Keys
VITE_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...                       # for source map uploads

# ─── Mux (video hosting) ─────────────────────────────────────────────────────
# https://dashboard.mux.com → Settings → API Access Tokens
MUX_TOKEN_ID=your-token-id
MUX_TOKEN_SECRET=your-token-secret
VITE_MUX_ENV_KEY=your-env-key                      # for Mux Player

# ─── Cloudflare Images ───────────────────────────────────────────────────────
# https://dash.cloudflare.com → Images
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_IMAGES_TOKEN=your-token
VITE_CLOUDFLARE_IMAGES_ACCOUNT_HASH=your-account-hash

# ─── OneSignal (push notifications) ─────────────────────────────────────────
# https://onesignal.com → App → Keys & IDs
VITE_ONESIGNAL_APP_ID=your-app-id
ONESIGNAL_API_KEY=your-rest-api-key

# ─── DocuSeal (e-signatures) ─────────────────────────────────────────────────
# https://console.docuseal.com → API
DOCUSEAL_API_KEY=your-api-key
VITE_DOCUSEAL_URL=https://docuseal.com

# ─── Cal.com (booking) ───────────────────────────────────────────────────────
# https://cal.com → Settings → Developer → API Keys
CAL_API_KEY=cal_live_...
VITE_CAL_USERNAME=your-cal-username

# ─── Browserless (server-side PDF) ───────────────────────────────────────────
# https://browserless.io → API Keys
BROWSERLESS_TOKEN=your-token

# ─── Twilio (SMS — optional) ─────────────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_URL=https://yourdomain.com
